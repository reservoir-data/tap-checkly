{
  "type": "object",
  "properties": {
    "id": {
      "type": "number",
      "description": "The id of the maintenance window.",
      "example": 1
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "type": [
        "array",
        "null"
      ],
      "description": "The names of the checks and groups maintenance window should apply to.",
      "example": [
        "production"
      ],
      "items": {
        "type": "string"
      }
    },
    "startsAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "endsAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "repeatInterval": {
      "type": [
        "number",
        "null"
      ]
    },
    "repeatUnit": {
      "type": [
        "string",
        "null"
      ]
    },
    "repeatEndsAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "timezone": {
      "type": [
        "string",
        "null"
      ],
      "description": "Named IANA time zone used for recurring maintenance scheduling; UTC when no timezone is set.",
      "example": "America/New_York"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "statusPageVisibility": {
