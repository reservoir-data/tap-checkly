                  "example": "homepage-check"
                },
                "pending": {
                  "type": [
                    "boolean",
                    "null"
                  ],
                  "description": "True when the binding is reserved by an import plan that has not been deployed yet."
                },
                "sourceFile": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "The file in the project's repository that declares this resource, or null when not recorded.",
