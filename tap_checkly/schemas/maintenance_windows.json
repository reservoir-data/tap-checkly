          "type": [
            "boolean",
            "null"
          ]
        },
        "suppressAutoIncidents": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "notifyOnStart": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "notifyOnEnd": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reminderMinutesBefore": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer"
          }
        },
        "autoStart": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "autoEnd": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "showAffectedServices": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "statusPageIds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "x-format": {
              "guid": true
            }
          }
        },
        "serviceIds": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "x-format": {
              "guid": true
            }
          }
        },
        "componentConfigs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "statusPageId": {
                "type": [
                  "string",
                  "null"
                ],
                "x-format": {
                  "guid": true
                }
              },
              "affectAllComponents": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "components": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "properties": {
                    "componentId": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "x-format": {
                        "guid": true
                      }
                    },
                    "status": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
