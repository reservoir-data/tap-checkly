    "pauseAllChecks": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "silenceAlertsTags": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "silenceAllAlerts": {
      "type": [
        "boolean",
        "null"
      ]
    },
